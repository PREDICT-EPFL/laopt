class str_const // constexpr string
{
private:
    const char *const p_;
    const std::size_t sz_;

public:
    template <std::size_t N>
    constexpr str_const(const char (&a)[N]) : p_(a), sz_(N - 1) {}
    constexpr char operator[](std::size_t n)
    {
        return n < sz_ ? p_[n] : throw std::out_of_range("");
    }
    
    constexpr std::size_t size() { return sz_; } 
};

template <size_t _n, size_t _m = 1, size_t _offset = 0>
struct Variable
{
    static constexpr size_t n = _n;
    static constexpr size_t m = _m;
    static constexpr size_t size = n * m;
    
    static constexpr size_t offset = _offset;
    static constexpr size_t offset_end = offset + size;

    static std::string to_string()
    {
        std::stringstream ss;
        ss << "Var<" << n << "," << m << "> = primal[" << offset << ":" << offset_end << "]";
        return ss.str();
    }

    friend std::ostream &operator<<(std::ostream &o, const Variable &var)
    {
        o << var.to_string();
        return o;
    }
};

template <size_t index, size_t n, size_t m, size_t offset>
constexpr auto col(Variable<n, m, offset> Var)
{
    static_assert(index < m);
    constexpr size_t new_offset = offset + index * n;
    return Variable<n, 1, new_offset>();
}

