template <int val, typename First>
constexpr auto cumsum(First F)
{
    return std::make_tuple(val);
}
template <int val, typename First, typename... Rest>
constexpr auto cumsum(First F, Rest... R)
{
    return std::tuple_cat(std::make_tuple(val),
                            cumsum<val + First::size>(R...));
}
template <typename... VarTypes>
constexpr auto cumsum(tuple<VarTypes...> tup)
{
    return std::apply(cumsum<0, VarTypes...>, tup);
}

