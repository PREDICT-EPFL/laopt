Matrix<Scalar, 2, 1> f(const Ref<const Matrix<Scalar, 2, 1>> x, const Ref<const Matrix<Scalar, 1, 1>> p)
{
    Matrix<Scalar, 2, 1> y;
    y[0] = (x.sum()) * exp(p.sum());
    y[1] = 2 * (x.sum()) * (p.sum());
    return y;
}

