template<int index, int offset, typename... Ts>
struct print_tuple {
    constexpr void operator() (tuple<Ts...>& t) {
        const auto size = tuple_size<tuple<Ts...>>::value;
        auto arg = get<size - index - 1>(t);
        cout << "[offset = " << offset << "] " << arg << endl;
        print_tuple<index - 1, decltype(arg)::RowsAtCompileTime + offset, Ts...>{}(t);
    }
};

template<int offset, typename... Ts>
struct print_tuple<0, offset, Ts...> {
    constexpr void operator() (tuple<Ts...>& t) {
        const auto size = tuple_size<tuple<Ts...>>::value;
        auto arg = get<size-1>(t);
        cout << "[offset = " << offset << "] " << arg << endl;
    }
};

template<typename... Ts>
constexpr void print(tuple<Ts...>& t) {
    const auto size = tuple_size<tuple<Ts...>>::value;
    print_tuple<size - 1, 0, Ts...>{}(t);
}

namespace detail {
    template <class F, class Tuple, std::size_t... Is>
    constexpr decltype(auto) apply_impl(F&& f, Tuple&& tpl, std::index_sequence<Is...> ) {
        return std::forward<F>(f)(std::get<Is>(std::forward<Tuple>(tpl))...);
    }
}

template <class F, class Tuple>
constexpr decltype(auto) apply(F&& f, Tuple&& tpl) {
    return detail::apply_impl(std::forward<F>(f),
        std::forward<Tuple>(tpl),
        std::make_index_sequence<std::tuple_size<std::decay_t<Tuple>>::value>{});
}

